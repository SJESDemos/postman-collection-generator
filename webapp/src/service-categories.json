    {
      "id": "application-integration",
      "label": "Application Integration",
      "services": ["appflow", "appintegrations", "b2bi", "eventbridge", "mq", "mwaa", "mwaa-serverless", "pipes", "scheduler", "schemas", "sfn", "sns", "sqs", "swf"],
      "prefixes": []
    },
    {
      "id": "blockchain",
      "label": "Blockchain",
      "services": [],
      "prefixes": ["managedblockchain"]
    },
    {
      "id": "business-applications",
